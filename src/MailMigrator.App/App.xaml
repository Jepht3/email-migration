<Application x:Class="MailMigrator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MailMigrator.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/LewebmaxMailMigrator;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Accent.xaml" />
                <ResourceDictionary Source="Themes/JobPalette.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Assets/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:JobColorConverter x:Key="JobColor" />
            <conv:InitialsConverter x:Key="Initials" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:NumberConverter x:Key="Number" />
            <conv:DurationConverter x:Key="Duration" />
            <conv:DateConverter x:Key="Date" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <conv:EqualsConverter x:Key="EqualsTo" />
            <conv:StatusTextConverter x:Key="StatusText" />
            <conv:FolderSymbolConverter x:Key="FolderSymbol" />
            <conv:HexBrushConverter x:Key="HexBrush" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:YesNoConverter x:Key="YesNo" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
