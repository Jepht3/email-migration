<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces : blanc à 85 % posé sur le Mica -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceStrong" Color="#FAFBFC" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#0A0F172A" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#0F0F172A" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#140F172A" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#120F172A" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E8ECF2" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#33000000" />
    <Color x:Key="Color.Shadow">#0F172A</Color>
    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EEF4FF" />
        <GradientStop Offset="1" Color="#F5F0FF" />
    </LinearGradientBrush>

    <!-- Texte : 3 niveaux de contraste (AA sur fond blanc) -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#526075" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#94A3B8" />

    <!-- États -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.Status.SuccessSoft" Color="#1A16A34A" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.Status.WarningSoft" Color="#1FD97706" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.Status.ErrorSoft" Color="#17DC2626" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.Status.InfoSoft" Color="#1A0EA5E9" />
    <SolidColorBrush x:Key="Brush.Status.Paused" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.Status.PausedSoft" Color="#1A64748B" />
</ResourceDictionary>
