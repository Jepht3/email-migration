<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:MailMigrator.App.Behaviors">

    <!-- Grille de 4 px -->
    <Thickness x:Key="Space.PagePadding">32,16,32,32</Thickness>
    <Thickness x:Key="Space.CardPadding">20</Thickness>
    <Thickness x:Key="Space.TilePadding">16</Thickness>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Ombre très légère ; une instance par carte pour pouvoir l'animer au survol -->
    <DropShadowEffect x:Key="Shadow.Card" x:Shared="False" BlurRadius="16" ShadowDepth="2" Direction="270"
                      Opacity="0.06" Color="{DynamicResource Color.Shadow}" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Panel" x:Shared="False" BlurRadius="40" ShadowDepth="0"
                      Opacity="0.22" Color="{DynamicResource Color.Shadow}" RenderingBias="Performance" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Space.CardPadding}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="b:HoverLift.IsEnabled" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Card}" />
    </Style>

    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Space.TilePadding}" />
    </Style>

    <!-- Encadré discret à l'intérieur d'une carte -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    </Style>

    <!-- Pastille d'icône ronde (tuiles, en-têtes) -->
    <Style x:Key="IconBubble" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    </Style>

    <!-- Focus visible au clavier sur les cartes cliquables -->
    <Style x:Key="Focus.Card">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="14" BorderBrush="{DynamicResource Brush.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ligne de liste sans chrome de sélection (flux d'activité, tableaux) -->
    <Style x:Key="ListItem.Plain" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="List.Plain" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem.Plain}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aperçus de thème (indépendants du thème courant) -->
    <SolidColorBrush x:Key="Brush.Preview.Light" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Brush.Preview.Dark" Color="#1E1E24" />
    <SolidColorBrush x:Key="Brush.Preview.Icon" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.Preview.Sun" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Preview.Moon" Color="#A5B4FC" />

    <!-- En-tête de colonnes des tableaux -->
    <Style x:Key="Text.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}" />
</ResourceDictionary>
