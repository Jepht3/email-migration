<!-- Couleurs d'identité des 5 tâches simultanées : bleu, violet, turquoise, orange, rose. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Job0.Start">#60A5FA</Color>
    <Color x:Key="Color.Job0.End">#2563EB</Color>
    <Color x:Key="Color.Job1.Start">#A78BFA</Color>
    <Color x:Key="Color.Job1.End">#7C3AED</Color>
    <Color x:Key="Color.Job2.Start">#2DD4BF</Color>
    <Color x:Key="Color.Job2.End">#0D9488</Color>
    <Color x:Key="Color.Job3.Start">#FDBA74</Color>
    <Color x:Key="Color.Job3.End">#EA580C</Color>
    <Color x:Key="Color.Job4.Start">#F9A8D4</Color>
    <Color x:Key="Color.Job4.End">#DB2777</Color>
</ResourceDictionary>
