<UserControl x:Class="MailMigrator.App.Controls.OptionToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <!-- Interrupteur clair avec une phrase d'explication -->
    <Grid Margin="0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Brush.SurfaceSubtle}">
            <ui:SymbolIcon Filled="True" Symbol="{Binding Symbol, ElementName=Root}" FontSize="22" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title, ElementName=Root}" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Paragraph}" FontSize="12" LineHeight="17" Text="{Binding Description, ElementName=Root}" />
        </StackPanel>
        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Top" IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Title, ElementName=Root}" />
    </Grid>
</UserControl>
