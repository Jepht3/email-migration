<Page x:Class="MailMigrator.App.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:MailMigrator.App.Controls"
      xmlns:r="clr-namespace:MailMigrator.Core.Reporting;assembly=MailMigrator.Core"
      Title="Historique">
    <Grid Margin="{StaticResource Space.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Historique" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.BodySecondary}" Text="Toutes les migrations passées. Ouvrez une ligne pour consulter son rapport détaillé." />
        </StackPanel>

        <!-- Filtres -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="Rechercher une adresse email…" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Rechercher dans l'historique" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Filtrer par statut" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding PeriodFilters}" DisplayMemberPath="Label" SelectedItem="{Binding PeriodFilter}" AutomationProperties.Name="Filtrer par date" />
            <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                       Text="{Binding VisibleCount, StringFormat='{}{0} migration(s)'}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,8,36,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.ColumnHeader}" Text="Source → destination" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.ColumnHeader}" Text="Date" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Text.ColumnHeader}" Text="Messages" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource Text.ColumnHeader}" Text="Volume" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource Text.ColumnHeader}" Text="Durée" />
                    <TextBlock Grid.Column="5" Margin="24,0,0,0" Style="{StaticResource Text.ColumnHeader}" Text="Statut" />
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource List.Plain}" ItemsSource="{Binding ItemsView}" AutomationProperties.Name="Liste des migrations">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type r:MigrationHistoryEntry}">
                            <Grid Margin="12,10" Background="Transparent" Cursor="Hand">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding ColorIndex, Converter={StaticResource JobColor}}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                                   Text="{Binding SourceEmail, Converter={StaticResource Initials}}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding SourceEmail}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DestinationEmail, StringFormat='→ {0}'}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.CaptionNumber}" FontSize="13"
                                           Text="{Binding StartedAt, Converter={StaticResource Date}, ConverterParameter=long}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Text.NumberSmall}"
                                           Text="{Binding Copied, Converter={StaticResource Number}}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Text.CaptionNumber}" FontSize="13"
                                           Text="{Binding Bytes, Converter={StaticResource Bytes}}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Text.CaptionNumber}" FontSize="13"
                                           Text="{Binding Duration, Converter={StaticResource Duration}}" />
                                <c:StatusBadge Grid.Column="5" Margin="24,0,0,0" Status="{Binding Status}" />
                                <ui:SymbolIcon Grid.Column="6" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Aucun résultat -->
                <StackPanel Grid.Row="1" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding VisibleCount, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Background="{DynamicResource Brush.AccentSoft}">
                        <ui:SymbolIcon Symbol="History24" FontSize="32" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Margin="0,16,0,4" HorizontalAlignment="Center" Style="{StaticResource Text.CardTitle}" Text="Aucune migration ne correspond" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.BodySecondary}" Text="Modifiez la recherche ou les filtres, ou lancez une nouvelle migration." />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Command="{Binding ClearFiltersCommand}" Icon="{ui:SymbolIcon FilterDismiss24}" Content="Effacer les filtres" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding NewMigrationCommand}" Icon="{ui:SymbolIcon Add24}" Content="Nouvelle migration" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
