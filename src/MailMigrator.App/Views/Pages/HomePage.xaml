<Page x:Class="MailMigrator.App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:MailMigrator.App.Controls"
      Title="Accueil">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.PagePadding}" MaxWidth="1400">

            <!-- Bienvenue -->
            <TextBlock Style="{StaticResource Text.PageTitle}">
                <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text=", bienvenue" />
            </TextBlock>
            <TextBlock Margin="0,4,0,24" Style="{StaticResource Text.BodySecondary}"
                       Text="Migrez des boîtes email IMAP d'un serveur à l'autre, en toute sécurité, jusqu'à 5 en parallèle." />

            <!-- Bandeau principal -->
            <Border Style="{StaticResource Card}" Padding="32,28" Margin="0,0,0,24" Background="{DynamicResource Brush.Hero}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Prêt pour une nouvelle migration ?" />
                        <TextBlock Margin="0,8,0,20" MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Paragraph}"
                                   Text="Saisissez les boîtes source et destination : les serveurs sont détectés automatiquement, puis tous les dossiers et emails sont copiés, avec leurs dates et leurs drapeaux, sans jamais créer de doublon." />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Padding="20,10" FontSize="15" Command="{Binding NewMigrationCommand}"
                                       Icon="{ui:SymbolIcon Add24}" Content="Nouvelle migration"
                                       AutomationProperties.Name="Nouvelle migration" />
                            <ui:Button Margin="12,0,0,0" Padding="16,10" Appearance="Secondary" Command="{Binding ShowRunningCommand}"
                                       Visibility="{Binding Running.ActiveCount, Converter={StaticResource HasValueToVisibility}}"
                                       Icon="{ui:SymbolIcon ArrowSync24}">
                                <TextBlock>
                                    <Run Text="Voir les" /> <Run Text="{Binding Running.ActiveCount, Mode=OneWay}" /> <Run Text="migrations en cours" />
                                </TextBlock>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Illustration : deux boîtes reliées -->
                    <Grid Grid.Column="1" Margin="32,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" Effect="{StaticResource Shadow.Card}">
                                <ui:SymbolIcon Symbol="MailInbox24" FontSize="34" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Border>
                            <c:FlowArrow Margin="12,0" />
                            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource Brush.Accent}" Effect="{StaticResource Shadow.Card}">
                                <ui:SymbolIcon Symbol="MailInboxCheckmark24" FontSize="34" Foreground="{DynamicResource Brush.OnAccent}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Statistiques -->
            <UniformGrid Columns="4" Margin="-8,0,-8,24">
                <Border Style="{StaticResource Tile}" Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="MailMultiple24" FontSize="20" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <c:AnimatedNumber Margin="0,12,0,0" Style="{StaticResource Text.Number}" Value="{Binding MailboxesMigrated}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Boîtes migrées" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left" Background="{DynamicResource Brush.Status.SuccessSoft}">
                            <ui:SymbolIcon Symbol="MailInboxCheckmark24" FontSize="20" Foreground="{DynamicResource Brush.Status.Success}" />
                        </Border>
                        <c:AnimatedNumber Margin="0,12,0,0" Style="{StaticResource Text.Number}" Value="{Binding EmailsCopied}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Emails copiés" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left" Background="{DynamicResource Brush.Status.InfoSoft}">
                            <ui:SymbolIcon Symbol="DataUsage24" FontSize="20" Foreground="{DynamicResource Brush.Status.Info}" />
                        </Border>
                        <c:AnimatedNumber Margin="0,12,0,0" Style="{StaticResource Text.Number}" Format="Bytes" Value="{Binding TotalBytes}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Volume total migré" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left" Background="{DynamicResource Brush.Status.WarningSoft}">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="20" Foreground="{DynamicResource Brush.Status.Warning}" />
                        </Border>
                        <c:AnimatedNumber Margin="0,12,0,0" Style="{StaticResource Text.Number}" Format="Percent" Value="{Binding SuccessRate}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Taux de réussite" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Dernières migrations -->
            <Grid Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Dernières migrations" />
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Command="{Binding ShowHistoryCommand}"
                           Content="Tout l'historique" Icon="{ui:SymbolIcon ChevronRight24}" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="12,10" CornerRadius="8" Background="Transparent" Cursor="Hand"
                                        Focusable="True" FocusVisualStyle="{StaticResource Focus.Card}"
                                        AutomationProperties.Name="{Binding SourceEmail, StringFormat='Ouvrir le rapport de {0}'}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                        <KeyBinding Key="Enter" Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{Binding ColorIndex, Converter={StaticResource JobColor}}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                                       Text="{Binding SourceEmail, Converter={StaticResource Initials}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding SourceEmail}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DestinationEmail}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.NumberSmall}" Text="{Binding Copied, Converter={StaticResource Number}, StringFormat='{}{0} emails'}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Bytes, Converter={StaticResource Bytes}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <c:StatusBadge Status="{Binding Status}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding StartedAt, Converter={StaticResource Date}, ConverterParameter=long}" />
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="4" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- État vide -->
                    <StackPanel Margin="0,32" HorizontalAlignment="Center"
                                Visibility="{Binding Recent.Count, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Brush.AccentSoft}">
                            <ui:SymbolIcon Symbol="MailInbox24" FontSize="32" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <TextBlock Margin="0,16,0,4" HorizontalAlignment="Center" Style="{StaticResource Text.CardTitle}" Text="Lancez votre première migration" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.BodySecondary}" Text="Les migrations terminées apparaîtront ici avec leur rapport." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
