<Page x:Class="MailMigrator.App.Views.Pages.RunningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:MailMigrator.App.Controls"
      xmlns:b="clr-namespace:MailMigrator.App.Behaviors"
      xmlns:vm="clr-namespace:MailMigrator.App.ViewModels"
      xmlns:p="clr-namespace:MailMigrator.Core.Progress;assembly=MailMigrator.Core"
      Title="Migrations en cours">

    <Grid>
        <!-- ================= Contenu principal ================= -->
        <Grid Margin="{StaticResource Space.PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Migrations en cours" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.BodySecondary}">
                        <Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" en cours · " /><Run Text="{Binding QueuedCount, Mode=OneWay}" /><Run Text=" en file d'attente · " /><Run Text="{Binding FinishedCount, Mode=OneWay}" /><Run Text=" terminée(s)" />
                    </TextBlock>
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary" Command="{Binding NewMigrationCommand}"
                           Icon="{ui:SymbolIcon Add24}" Content="Nouvelle migration" />
            </Grid>

            <!-- Bandeau global -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20"
                    Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="128" Height="128">
                        <c:ProgressGauge Thickness="12" Value="{Binding OverallProgress}" TrackBrush="{DynamicResource Brush.Track}"
                                         StartColor="{DynamicResource Color.AccentGradientStart}" EndColor="{DynamicResource Color.AccentGradientEnd}"
                                         AutomationProperties.Name="Progression globale" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:AnimatedNumber HorizontalAlignment="Center" Style="{StaticResource Text.Number}" Format="Percent" Value="{Binding OverallProgress}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="au total" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Column="1" Margin="32,0" Columns="3" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataUsage24" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}" Text="Volume copié" />
                            </StackPanel>
                            <c:AnimatedNumber Margin="0,6,0,0" Style="{StaticResource Text.Number}" Format="Bytes" Value="{Binding BytesProcessed}" />
                            <TextBlock Style="{StaticResource Text.CaptionNumber}" Text="{Binding TotalBytes, Converter={StaticResource Bytes}, StringFormat='sur {0}'}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}" Text="Vitesse cumulée" />
                            </StackPanel>
                            <c:AnimatedNumber Margin="0,6,0,0" Style="{StaticResource Text.Number}" Format="Speed" Value="{Binding BytesPerSecond}" />
                            <TextBlock Style="{StaticResource Text.CaptionNumber}">
                                <Run Text="{Binding MessagesPerMinute, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" messages / min" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}" Text="Temps restant estimé" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Number}" Text="{Binding Remaining, Converter={StaticResource Duration}}" />
                            <TextBlock Style="{StaticResource Text.CaptionNumber}">
                                <Run Text="{Binding MessagesProcessed, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding MessagesTotal, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" messages" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>

                    <Border Grid.Column="2" Width="280" Style="{StaticResource Inset}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Débit · 60 dernières secondes" />
                            </Grid>
                            <c:Sparkline Height="72" Margin="0,8,0,0" Values="{Binding Throughput}" Revision="{Binding ThroughputRevision}"
                                         LineColor="{DynamicResource Color.AccentGradientEnd}" AutomationProperties.Name="Courbe du débit" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Grille des tâches -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0"
                          Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Jobs}" Focusable="False" Padding="0,4,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AdaptiveGrid MinItemWidth="400" Spacing="16" MaxColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
                            <Border Style="{StaticResource Card.Interactive}" Padding="0"
                                    AutomationProperties.Name="{Binding SourceEmail, StringFormat='Migration de {0}, ouvrir le détail'}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Height="4" VerticalAlignment="Top" CornerRadius="12,12,0,0" Background="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=Gradient}" />

                                    <StackPanel Grid.Row="1" Margin="20,16,20,16">
                                        <!-- En-tête -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=Gradient}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                                           Text="{Binding SourceEmail, Converter={StaticResource Initials}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding SourceEmail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceEmail}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DestinationEmail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationEmail}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <c:StatusBadge Grid.Column="2" VerticalAlignment="Top" Status="{Binding Status}" />
                                        </Grid>

                                        <!-- Progression globale -->
                                        <Grid Margin="0,18,0,6">
                                            <TextBlock Style="{StaticResource Text.CaptionNumber}">
                                                <Run Text="{Binding Processed, Converter={StaticResource Number}, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{Binding Total, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" messages · " /><Run Text="{Binding BytesProcessed, Converter={StaticResource Bytes}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                            </TextBlock>
                                            <c:AnimatedNumber HorizontalAlignment="Right" Style="{StaticResource Text.NumberSmall}" Format="Percent" Value="{Binding Progress}" />
                                        </Grid>
                                        <c:GradientBar Height="10" Value="{Binding Progress}" TrackBrush="{DynamicResource Brush.Track}"
                                                       StartColor="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=Start}"
                                                       EndColor="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=End}"
                                                       AutomationProperties.Name="Progression de la migration" />

                                        <!-- Dossier en cours / préparation / file d'attente -->
                                        <Grid Margin="0,12,0,0" MinHeight="34">
                                            <Grid Visibility="{Binding CurrentFolder, Converter={StaticResource HasValueToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <TextBlock Grid.Column="1" Margin="6,0" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="Dossier en cours :" /> <Run Text="{Binding CurrentFolder, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.CaptionNumber}">
                                                    <Run Text="{Binding FolderProcessed, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding FolderTotal, Converter={StaticResource Number}, Mode=OneWay}" />
                                                </TextBlock>
                                                <c:GradientBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Height="4" Value="{Binding FolderProgress}" TrackBrush="{DynamicResource Brush.Track}"
                                                               StartColor="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=End}"
                                                               EndColor="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=End}" />
                                            </Grid>
                                            <StackPanel Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
                                                <c:Skeleton Width="220" Height="10" HorizontalAlignment="Left" />
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="Connexion aux serveurs et analyse des dossiers…" />
                                            </StackPanel>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibility}}"
                                                       Text="En attente d'une place libre (5 migrations simultanées maximum)." />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Durée totale :" /> <Run Text="{Binding Elapsed, Converter={StaticResource Duration}, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </Grid>

                                        <!-- Compteurs -->
                                        <UniformGrid Margin="0,14,0,0" Columns="3" Visibility="{Binding ShowCounters, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Inset}" Margin="0,0,6,0" Padding="12,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource Brush.Status.Success}" />
                                                        <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.Caption}" Text="Copiés" />
                                                    </StackPanel>
                                                    <c:AnimatedNumber Margin="0,2,0,0" Style="{StaticResource Text.Number}" FontSize="22" Value="{Binding Copied}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Inset}" Margin="3,0" Padding="12,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowForward24" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                        <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.Caption}" Text="Déjà présents" />
                                                    </StackPanel>
                                                    <c:AnimatedNumber Margin="0,2,0,0" Style="{StaticResource Text.Number}" FontSize="22" Value="{Binding Skipped}" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="FailedBox" Style="{StaticResource Inset}" Margin="6,0,0,0" Padding="12,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Foreground="{DynamicResource Brush.Status.Error}" />
                                                        <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.Caption}" Text="Échecs" />
                                                    </StackPanel>
                                                    <c:AnimatedNumber x:Name="FailedNumber" Margin="0,2,0,0" Style="{StaticResource Text.Number}" FontSize="22" Value="{Binding Failed}"
                                                                      Foreground="{DynamicResource Brush.Status.Error}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Pied : vitesse, temps restant, actions -->
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <TextBlock Margin="4,0,14,0" Style="{StaticResource Text.CaptionNumber}">
                                                    <Run Text="{Binding MessagesPerMinute, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" msg/min · " /><Run Text="{Binding BytesPerSecond, Converter={StaticResource Bytes}, Mode=OneWay}" /><Run Text="/s" />
                                                </TextBlock>
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.CaptionNumber}" Text="{Binding Remaining, Converter={StaticResource Duration}, StringFormat='Reste {0}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button Appearance="Transparent" Padding="8" Command="{Binding PauseCommand}" Icon="{ui:SymbolIcon Pause24}"
                                                           ToolTip="Mettre en pause" AutomationProperties.Name="Mettre en pause"
                                                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <ui:Button Appearance="Transparent" Padding="8" Command="{Binding ResumeCommand}" Icon="{ui:SymbolIcon Play24}"
                                                           ToolTip="Reprendre" AutomationProperties.Name="Reprendre"
                                                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:Button Appearance="Transparent" Padding="8" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Dismiss24}"
                                                           ToolTip="Annuler la migration" AutomationProperties.Name="Annuler la migration" />
                                                <ui:Button Appearance="Transparent" Padding="8" Command="{Binding OpenReportCommand}" Icon="{ui:SymbolIcon DocumentText24}"
                                                           ToolTip="Voir le rapport" AutomationProperties.Name="Voir le rapport"
                                                           Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="0">
                                    <Setter TargetName="FailedNumber" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- État vide -->
            <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" Background="{DynamicResource Brush.AccentSoft}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="44" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Margin="0,20,0,6" HorizontalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="Aucune migration en cours" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.BodySecondary}" Text="Lancez votre première migration : sa progression s'affichera ici en direct." />
                <ui:Button Margin="0,20,0,0" HorizontalAlignment="Center" Appearance="Primary" Command="{Binding NewMigrationCommand}"
                           Icon="{ui:SymbolIcon Add24}" Content="Nouvelle migration" />
            </StackPanel>
        </Grid>

        <!-- ================= Panneau de détail ================= -->
        <Border x:Name="Scrim" Background="{DynamicResource Brush.Scrim}" Visibility="Collapsed" Opacity="0" MouseLeftButtonDown="OnScrimClick" />
        <Border x:Name="DetailPanel" Width="560" HorizontalAlignment="Right" Margin="0,8,8,8" Visibility="Collapsed"
                Background="{DynamicResource Brush.SurfaceStrong}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                CornerRadius="12" Effect="{StaticResource Shadow.Panel}" DataContext="{Binding SelectedJob}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailTranslate" X="600" />
            </Border.RenderTransform>
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- En-tête du panneau -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{Binding ColorIndex, Converter={StaticResource JobColor}, ConverterParameter=Gradient}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                   Text="{Binding SourceEmail, Converter={StaticResource Initials}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding SourceEmail}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DestinationEmail, StringFormat='vers {0}'}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Fermer le détail (Échap)"
                               AutomationProperties.Name="Fermer le détail"
                               Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <c:StatusBadge Status="{Binding Status}" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.CaptionNumber}">
                        <Run Text="Écoulé" /> <Run Text="{Binding Elapsed, Converter={StaticResource Duration}, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · reste " /><Run Text="{Binding Remaining, Converter={StaticResource Duration}, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Grid>

                <!-- Dossiers -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Dossiers" />
                    <ScrollViewer Margin="0,8,0,0" MaxHeight="232" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                                    <Grid x:Name="Row" Margin="0,0,8,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Role, Converter={StaticResource FolderSymbol}}" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock x:Name="Name" Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <c:GradientBar Grid.Column="2" Height="6" Margin="8,0" Value="{Binding Fraction}" TrackBrush="{DynamicResource Brush.Track}"
                                                       StartColor="{Binding DataContext.ColorIndex, ElementName=DetailPanel, Converter={StaticResource JobColor}, ConverterParameter=Start}"
                                                       EndColor="{Binding DataContext.ColorIndex, ElementName=DetailPanel, Converter={StaticResource JobColor}, ConverterParameter=End}" />
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource Text.CaptionNumber}">
                                            <Run Text="{Binding Processed, Converter={StaticResource Number}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Total, Converter={StaticResource Number}, Mode=OneWay}" />
                                        </TextBlock>
                                        <ui:SymbolIcon x:Name="Done" Grid.Column="4" Symbol="CheckmarkCircle24" Filled="True" FontSize="16" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource Brush.Status.Success}" Visibility="Hidden" ToolTip="Dossier terminé" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Flux d'activité -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Status.Success}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.BodyStrong}" Text="Activité en direct" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <CheckBox Content="Erreurs uniquement" IsChecked="{Binding OnlyErrors}" Margin="0,0,8,0" />
                            <ToggleButton Padding="8,4" IsChecked="{Binding IsScrollFrozen}" ToolTip="Figer / reprendre le défilement automatique"
                                          AutomationProperties.Name="Figer le défilement">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pin24" FontSize="14" />
                                    <TextBlock Margin="6,0,0,0" FontSize="12" Text="Figer" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Padding="4">
                        <ListBox x:Name="ActivityList" Style="{StaticResource List.Plain}" ItemsSource="{Binding ActivityView}"
                                 b:AutoScroll.Follow="{Binding IsScrollFrozen, Converter={StaticResource InvertBool}}"
                                 AutomationProperties.Name="Flux d'activité">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActivityItemViewModel}">
                                    <Grid b:Reveal.OnLoad="True" Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:SymbolIcon x:Name="Icon" Symbol="CheckmarkCircle24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Status.Success}" />
                                        <Border x:Name="FolderChip" Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource Chip}" Padding="6,0">
                                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Text="{Binding Folder}" />
                                        </Border>
                                        <TextBlock x:Name="Date" Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource Text.CaptionNumber}" VerticalAlignment="Center"
                                                   Text="{Binding MessageDate, Converter={StaticResource Date}}" />
                                        <TextBlock x:Name="Text" Grid.Column="3" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}">
                                            <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Subject, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource Text.CaptionNumber}" VerticalAlignment="Center"
                                                   Text="{Binding Size, Converter={StaticResource Bytes}}" Visibility="{Binding IsMessage, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Status.Error}" Text="{Binding Reason}"
                                                   Visibility="{Binding Reason, Converter={StaticResource HasValueToVisibility}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:ActivityKind.Skipped}">
                                            <Setter TargetName="Icon" Property="Symbol" Value="ArrowForward24" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:ActivityKind.Failed}">
                                            <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:ActivityKind.Info}">
                                            <Setter TargetName="Icon" Property="Symbol" Value="Info24" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Status.Info}" />
                                            <Setter TargetName="FolderChip" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Date" Property="Text" Value="{Binding Timestamp, Converter={StaticResource Date}, ConverterParameter=time}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:ActivityKind.Warning}">
                                            <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                            <Setter TargetName="FolderChip" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Date" Property="Text" Value="{Binding Timestamp, Converter={StaticResource Date}, ConverterParameter=time}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
