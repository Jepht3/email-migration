<ui:FluentWindow x:Class="MailMigrator.App.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:MailMigrator.App.Views.Pages"
                 Title="LEWEBMAX Mail Migrator"
                 Width="1440" Height="900" MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="248"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           Transition="FadeInWithSlide"
                           TransitionDuration="200">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="14,4,12,16" Orientation="Horizontal">
                    <Image Width="32" Height="32" Source="{StaticResource Logo.Mark}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="LEWEBMAX" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Mail Migrator" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Accueil" TargetPageType="{x:Type pages:HomePage}"
                                       ToolTip="Accueil" Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="Nouvelle migration" TargetPageType="{x:Type pages:NewMigrationPage}"
                                       ToolTip="Nouvelle migration" Icon="{ui:SymbolIcon AddCircle24}" />
                <ui:NavigationViewItem Content="Migrations en cours" TargetPageType="{x:Type pages:RunningPage}"
                                       ToolTip="Migrations en cours" Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:NavigationViewItem Content="Historique" TargetPageType="{x:Type pages:HistoryPage}"
                                       ToolTip="Historique" Icon="{ui:SymbolIcon History24}" />
                <ui:NavigationViewItem Content="Sauvegardes locales" TargetPageType="{x:Type pages:BackupsPage}"
                                       ToolTip="Sauvegardes locales" Icon="{ui:SymbolIcon Archive24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Paramètres" TargetPageType="{x:Type pages:SettingsPage}"
                                       ToolTip="Paramètres" Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <TextBlock x:Name="VersionText" Margin="16,4,16,12" Style="{StaticResource Text.Caption}" />
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.ContentOverlay>
                <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom" />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="LEWEBMAX Mail Migrator">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource Logo.Mark}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
