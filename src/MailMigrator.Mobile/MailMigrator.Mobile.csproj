<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application Android (.NET MAUI) : même cœur que la version Windows (MailMigrator.Core). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>MailMigrator.Mobile</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <ApplicationTitle>LEWEBMAX Migrator</ApplicationTitle>
    <ApplicationId>com.lewebmax.mailmigrator</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>11</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <!-- Signature de la version Release : clé hors dépôt (variables d'environnement ou fichier local). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(ANDROID_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>lewebmax</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563EB" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Correctif de sécurité d'une dépendance transitive de MAUI (GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailMigrator.Core\MailMigrator.Core.csproj" />
  </ItemGroup>

</Project>
